 ],
 "fields": [
  {
   "fieldname": "account_name",
   "fieldtype": "Data",
   "label": "Account Name",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "provider",
   "fieldtype": "Select",
   "label": "Provider",
   "options": "Daraja\nPesapal",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Enabled",
   "default": "0",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Master on/off switch. Disabled accounts are hidden from checkout and refuse new payments; callbacks for existing payments are still processed."
  },
  {
   "fieldname": "column_break_main",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "environment",
   "fieldtype": "Select",
   "label": "Environment",
   "options": "Sandbox\nLive",
   "default": "Sandbox",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "is_default",
   "fieldtype": "Check",
   "label": "Default for Provider",
   "default": "0"
  },
  {
   "fieldname": "currency",
   "fieldtype": "Link",
   "label": "Currency",
   "options": "Currency",
   "default": "KES",
   "reqd": 1
  },
  {
   "fieldname": "display_label",
   "fieldtype": "Data",
   "label": "Checkout Label",
   "description": "Shown to payers, e.g. \"M-Pesa\" or \"Card / Mobile Money\". Defaults to the provider name."
  },
  {
   "fieldname": "section_callbacks",
   "fieldtype": "Section Break",
   "label": "Callbacks"
  },
  {
   "fieldname": "callback_base_url",
   "fieldtype": "Data",
   "label": "Public Callback Base URL",
   "description": "Public https origin the provider can reach, e.g. https://lms.example.com. Leave empty to use the site URL. For local development use a tunnel (ngrok, cloudflared)."
  },
  {
   "fieldname": "callback_id",
   "fieldtype": "Data",
   "label": "Callback ID",
   "read_only": 1,
   "unique": 1,
   "description": "Random public identifier used in callback URLs (provider URLs must not contain the account name)."
  },
  {
   "fieldname": "callback_token",
   "fieldtype": "Password",
   "label": "Callback Token",
   "read_only": 1,
   "description": "Auto-generated secret embedded in callback URLs. Callbacks without it are rejected."
  },
  {
   "fieldname": "callback_ip_allowlist",
   "fieldtype": "Small Text",
   "label": "Callback IP Allowlist",
   "description": "Optional. One IP per line. When set, callbacks from other IPs are rejected (useful for Safaricom's published callback IPs)."
  },
  {
   "fieldname": "allowed_return_origins",
   "fieldtype": "Small Text",
   "label": "Allowed Return URL Origins",
   "description": "Origins payers may be sent back to after a redirect checkout (Pesapal), one per line, e.g. https://lms.example.com or http://localhost:3000. Empty = site URL only."
  },
  {
   "fieldname": "section_daraja",
   "fieldtype": "Section Break",
   "label": "Safaricom Daraja (M-Pesa STK Push)",
   "depends_on": "eval:doc.provider=='Daraja'"
  },
  {
   "fieldname": "daraja_consumer_key",
   "fieldtype": "Data",
   "label": "Consumer Key",
   "mandatory_depends_on": "eval:doc.provider=='Daraja' && doc.enabled"
  },
  {
   "fieldname": "daraja_consumer_secret",
   "fieldtype": "Password",
   "label": "Consumer Secret",
   "mandatory_depends_on": "eval:doc.provider=='Daraja' && doc.enabled"
  },
  {
   "fieldname": "daraja_shortcode",
   "fieldtype": "Data",
   "label": "Business Short Code",
   "mandatory_depends_on": "eval:doc.provider=='Daraja' && doc.enabled",
   "description": "Paybill number, or the Head Office store number for Buy Goods. Sandbox: 174379."
  },
  {
   "fieldname": "column_break_daraja",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "daraja_passkey",
   "fieldtype": "Password",
   "label": "Lipa Na M-Pesa Passkey",
   "mandatory_depends_on": "eval:doc.provider=='Daraja' && doc.enabled"
  },
  {
   "fieldname": "daraja_transaction_type",
   "fieldtype": "Select",
   "label": "Transaction Type",
   "options": "CustomerPayBillOnline\nCustomerBuyGoodsOnline",
   "default": "CustomerPayBillOnline"
  },
  {
   "fieldname": "daraja_party_b",
   "fieldtype": "Data",
   "label": "Party B (Till Number)",
   "depends_on": "eval:doc.daraja_transaction_type=='CustomerBuyGoodsOnline'",
   "description": "Till number receiving Buy Goods payments. Defaults to the short code."
  },
  {
   "fieldname": "section_pesapal",
   "fieldtype": "Section Break",
   "label": "Pesapal (API 3.0)",
   "depends_on": "eval:doc.provider=='Pesapal'"
  },
  {
   "fieldname": "pesapal_consumer_key",
   "fieldtype": "Data",
   "label": "Consumer Key",
   "mandatory_depends_on": "eval:doc.provider=='Pesapal' && doc.enabled"
  },
  {
   "fieldname": "pesapal_consumer_secret",
   "fieldtype": "Password",
   "label": "Consumer Secret",
   "mandatory_depends_on": "eval:doc.provider=='Pesapal' && doc.enabled"
  },
  {
   "fieldname": "pesapal_country_code",
   "fieldtype": "Data",
   "label": "Billing Country Code",
   "default": "KE"
  },
  {
   "fieldname": "column_break_pesapal",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "pesapal_ipn_id",
   "fieldtype": "Data",
   "label": "IPN ID",
   "read_only": 1,
   "description": "Registered automatically on first use or via Register IPN."
  },
  {
   "fieldname": "pesapal_ipn_url",
   "fieldtype": "Small Text",
   "label": "Registered IPN URL",
   "read_only": 1
  },
  {
   "fieldname": "section_status",
   "fieldtype": "Section Break",
   "label": "Connection Check",
   "collapsible": 1
  },
  {
   "fieldname": "last_tested_at",
   "fieldtype": "Datetime",
   "label": "Last Tested At",
   "read_only": 1
  },
  {
   "fieldname": "last_test_result",
   "fieldtype": "Small Text",
   "label": "Last Test Result",
   "read_only": 1
  }
 ],
